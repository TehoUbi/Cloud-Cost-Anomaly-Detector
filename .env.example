# Copy to .env and edit. Every value here is a default from src/config.py —
# the service runs with none of them set, using the synthetic cost provider
# and no alert channels.

# --- Database -----------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://sentinel:sentinel@localhost:5432/sentinel
# Pool size is PER WORKER. Eight uvicorn workers at these defaults opens 240
# connections, past PostgreSQL's default max_connections of 100 — size this to
# your database, or put PgBouncer in front.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
# Seconds a request waits for a connection before being shed with a 503.
DB_POOL_TIMEOUT=10
DB_ECHO=false

# --- Cost data ----------------------------------------------------------
# aws       — live Cost Explorer; needs ce:GetCostAndUsage
# synthetic — deterministic generated spend, no AWS account, no per-request
#             charge (Cost Explorer bills $0.01 a call, which a dev loop notices)
COST_PROVIDER=aws
AWS_DEFAULT_REGION=us-east-1
# Read by boto3 itself, not by src/config.py. Omit both on EC2/ECS/Lambda and
# let the instance or execution role supply credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# UnblendedCost | BlendedCost | AmortizedCost
COST_EXPLORER_METRIC=UnblendedCost
COST_EXPLORER_MAX_RETRIES=4

# --- Detection ----------------------------------------------------------
# Sigma threshold to flag a day. 3.0 is roughly one false positive per service
# per 370 days on normal data; lower it for a noisier alert channel.
ZSCORE_THRESHOLD=3.0
# Trailing days in the baseline window.
WINDOW_SIZE=30
# Days of history before a service is scored at all. MAD tolerates 50%
# contamination, so a shorter window holding two or three spikes has no
# trustworthy centre.
MIN_HISTORY_DAYS=14
# Dollar floor. Without it a service billing $0.01/day that moves to $0.08 is
# a 144-sigma event worth seven cents, and it pages someone at 3am.
MIN_ABSOLUTE_DELTA_USD=1.0
# Score against median/MAD instead of mean/stddev. Leave on: with mean/stddev
# a single past spike inflates the baseline enough to hide the next one.
ROBUST_ZSCORE=true
# Cross-check z-score hits against a scikit-learn IsolationForest.
ENSEMBLE_ENABLED=true
# Whether a sudden FALL in spend should alert. Off by default — the day spend
# returns to normal after a spike is itself a drop, so alerting on both
# reports every incident twice. Drops are still recorded and visible in the API.
ALERT_ON_DROPS=false

# --- Alert delivery -----------------------------------------------------
# An alert goes to every configured channel. Leave both unset and anomalies
# are still detected and stored, just not delivered.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_TIMEOUT_SECONDS=10

# ses | smtp | disabled
ALERT_EMAIL_TRANSPORT=disabled
ALERT_EMAIL_FROM=sentinel@example.com
# Comma-separated, or a JSON array.
ALERT_EMAIL_TO=oncall@example.com,finops@example.com

# Only read when ALERT_EMAIL_TRANSPORT=smtp. SES needs none of it — the
# execution role covers auth. docker-compose points these at MailHog.
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Retry ladder per channel, per dispatch: 1s, 2s, 4s, 8s, 16s capped at
# max_delay, with jitter so N workers failing on one outage do not come back
# in lockstep. An alert that exhausts this keeps a next_retry_at and is swept
# on a later poll, so an outage longer than the ladder does not lose it.
ALERT_MAX_RETRIES=5
ALERT_BASE_DELAY_SECONDS=1.0
ALERT_MAX_DELAY_SECONDS=60
ALERT_BACKOFF_JITTER=0.25
# Suppress repeat alerts for the same service inside this window. A runaway
# instance spikes for days; without this it alerts every poll for a week and
# people start filtering the channel.
ALERT_COOLDOWN_HOURS=24

# --- Polling ------------------------------------------------------------
# Only used by scripts/poll_and_detect.py in loop mode. Under Lambda the
# schedule belongs to EventBridge.
POLL_INTERVAL_HOURS=6
# Days fetched per poll. Needs to exceed WINDOW_SIZE so a restated recent day
# is re-scored against a full baseline.
POLL_LOOKBACK_DAYS=45

# --- Service ------------------------------------------------------------
LOG_LEVEL=INFO
